#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build-tests"

if command -v qmake6 >/dev/null 2>&1; then
  QMAKE=qmake6
elif ! command -v qmake >/dev/null 2>&1 && [ "$(uname -s)" = Darwin ] \
    && command -v brew >/dev/null 2>&1 && [ -x "$(brew --prefix qtbase)/bin/qmake" ]; then
  # Homebrew keeps Qt's qmake off the PATH.
  QMAKE="$(brew --prefix qtbase)/bin/qmake"
else
  QMAKE=qmake
fi

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"
"$QMAKE" "$ROOT/tests/tests.pro"
make -j"$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1)"
QT_QPA_PLATFORM=offscreen ./tst_omawrite
